# DocPulse-RAG 环境变量模板
# 使用方法：复制本文件为 .env，填入真实密钥（.env 不要提交或打包分享）

# DeepSeek API Key（必填，用于 query / serve 生成答案）
# 获取：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# 可选：若未设置 DEEPSEEK_API_KEY，会回退读取 OPENAI_API_KEY
# OPENAI_API_KEY=your-openai-compatible-key-here

# LLM 模型、base_url、temperature 等见项目根目录 config.yaml 的 llm 段
